# Mahan Market Agent (local copy only; never commit real values)
PORT=3000
ADMIN_EMAIL=mahaneli1394@gmail.com

# Supabase Auth: use the project URL and public anon/publishable key.
# Never use the Supabase service_role key in the browser or this file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Create a new random secret with: npm run new-secret
N8N_PUSH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
N8N_MAX_CLOCK_SKEW_SECONDS=300

# Railway: connect a Volume mounted at /data, then use DATA_DIR=/data
DATA_DIR=.local-data

# Optional real workflow control in the admin dashboard:
# Base URL of your n8n instance (host root or /api/v1 URL)
N8N_API_BASE_URL=https://YOUR-N8N-HOST
N8N_API_KEY=YOUR_N8N_PUBLIC_API_KEY_WITH_WORKFLOW_READ_AND_ACTIVATE_SCOPES
N8N_WORKFLOW_ID=YOUR_WORKFLOW_ID
